# Copy to .env and fill in. NEVER commit .env or put these values in the mobile app.

# From https://developers.kite.trade -> My Apps -> your app
KITE_API_KEY=
KITE_API_SECRET=

# Long random secret shared with the mobile app (Settings screen). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# Where the server sends the phone after Kite login (matches "scheme" in mobile/app.json)
APP_REDIRECT=kitealgo://login

DATA_DIR=./data

# ---- Real-money safety switches (server-side; the app cannot override them) ----
LIVE_TRADING_ENABLED=false
MAX_LIVE_QTY=100
MAX_LIVE_DAILY_LOSS=2000
MAX_LIVE_ORDERS_PER_DAY=20
ORDER_TAG=kitealgo

# ---- Optional: AI-written analysis in the "AI" tab (Anthropic Claude API) ----
# Leave empty to use the free built-in rule-based summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max option lots per LIVE order / Auto Trade (server-side cap)
MAX_LIVE_LOTS=1

# ---- Optional: push alerts to your phone (free) ----
# Install the "ntfy" app (Play Store), subscribe to a long random topic name only you know, and put it here.
# You get a notification for every Auto Trade order, exit and problem — even when the Kite Algo app is closed.
NTFY_TOPIC=
